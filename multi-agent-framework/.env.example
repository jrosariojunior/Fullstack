# Database
DATABASE_URL=postgresql://multi_agent_user:multi_agent_pass@localhost:5432/multi_agent_db
REDIS_URL=redis://localhost:6379/0

# LLM Providers
CLAUDE_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Configuration
LLM_PROVIDER=claude  # claude or openai
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Framework Settings
MAX_DEBATE_ROUNDS=3
TOKEN_LIMIT=100000
PARALLEL_EXECUTION=true
HUMANIZE_OUTPUT=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or plain

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=false
